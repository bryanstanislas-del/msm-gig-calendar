{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "msm-gig-calendar.vercel.app" }
      ],
      "destination": "https://calendar.musicscenemagazine.co.uk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/ads/:action", "destination": "/api/ads?action=:action" },
    { "source": "/api/(.*)",     "destination": "/api/$1" },
    { "source": "/sitemap.xml",  "destination": "/api/sitemap" },
    { "source": "/robots.txt",   "destination": "/api/robots" },
    { "source": "/gig/:slug",    "destination": "/api/gig" },
    { "source": "/artist/:slug", "destination": "/api/og?type=band&slug=:slug" },
    { "source": "/venue/:slug",  "destination": "/api/og?type=venue&slug=:slug" },
    { "source": "/festival/:slug","destination": "/api/og?type=festival&slug=:slug" },
    { "source": "/(.*)",         "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
